# OPTIONAL ALB INGRESS TEMPLATE
# Rename to ingress.yaml only after installing AWS Load Balancer Controller
# and configuring its IAM role/Pod Identity permissions.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: netflix-app
  annotations:
    kubernetes.io/ingress.class: alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
spec:
  ingressClassName: alb
  rules:
    - http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: netflix-app
                port:
                  number: 80
